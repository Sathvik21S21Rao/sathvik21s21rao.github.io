---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// First project gets the full-width, image-led treatment; the rest run
// compact underneath it. Keeps the grid from reading as three equal cards
// no matter how many projects end up in the collection.
const [featured, ...rest] = projects;
---

<BaseLayout title="Projects" description="Things I've built, hardware, software, and everything in between.">
  <header class="page-head">
    <h1>Projects</h1>
    <p class="page-dek">A running list of things I've built, roughly in the order I'd want to talk about them.</p>
  </header>

  {projects.length === 0 ? (
    <p class="empty">Nothing here yet, check back soon.</p>
  ) : (
    <div class="project-grid">
      <article class="project project--featured" id={featured.id}>
        {featured.data.image && (
          <img
            class="project-image"
            src={featured.data.image.src}
            alt={featured.data.image.alt}
            width="1200"
            height="800"
            loading="eager"
          />
        )}
        <div class="project-body">
          <h2 class="project-name">{featured.data.name}</h2>
          <p class="project-blurb">{featured.data.blurb}</p>

          {featured.data.tags.length > 0 && (
            <ul class="project-tags">
              {featured.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}

          <div class="project-meta">
            {featured.data.year && <span class="project-year">{featured.data.year}</span>}
            {(featured.data.url || featured.data.repo) && (
              <div class="project-links">
                {featured.data.url && (
                  <a class="project-link" href={featured.data.url} rel="noopener noreferrer">Visit →</a>
                )}
                {featured.data.repo && (
                  <a class="project-link" href={featured.data.repo} rel="noopener noreferrer">Source →</a>
                )}
              </div>
            )}
          </div>
        </div>
      </article>

      {rest.length > 0 && (
        <div class="project-compact-grid">
          {rest.map((project) => (
            <article class="project project--compact" id={project.id}>
              {project.data.image && (
                <img
                  class="project-image"
                  src={project.data.image.src}
                  alt={project.data.image.alt}
                  width="1200"
                  height="800"
                  loading="lazy"
                />
              )}
              <div class="project-body">
                <h2 class="project-name">{project.data.name}</h2>
                <p class="project-blurb">{project.data.blurb}</p>

                {project.data.tags.length > 0 && (
                  <ul class="project-tags">
                    {project.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}

                <div class="project-meta">
                  {project.data.year && <span class="project-year">{project.data.year}</span>}
                  {(project.data.url || project.data.repo) && (
                    <div class="project-links">
                      {project.data.url && (
                        <a class="project-link" href={project.data.url} rel="noopener noreferrer">Visit →</a>
                      )}
                      {project.data.repo && (
                        <a class="project-link" href={project.data.repo} rel="noopener noreferrer">Source →</a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  )}
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-xl) var(--space-l);
    max-width: var(--measure);
  }

  .page-head h1 {
    font-size: var(--step-4);
  }

  .page-dek {
    color: var(--muted);
    font-size: var(--step-1);
    margin-top: var(--space-xs);
  }

  .empty {
    color: var(--muted);
    padding-block: var(--space-l);
  }

  .project-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block-end: var(--space-3xl);
  }

  .project {
    border-top: 1px solid var(--rule);
    padding-block-start: var(--space-l);
  }

  .project-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .project--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .project--featured .project-name {
    font-size: var(--step-3);
  }

  .project-compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-xl);
  }

  .project--compact .project-image {
    margin-bottom: var(--space-s);
  }

  .project--compact .project-name {
    font-size: var(--step-1);
  }

  .project-blurb {
    color: var(--muted);
    margin-top: var(--space-xs);
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project-tags li {
    color: var(--muted);
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    margin-top: var(--space-s);
  }

  .project-year {
    color: var(--muted);
    font-size: var(--step--1);
    font-family: var(--font-mono);
  }

  .project-links {
    display: flex;
    gap: var(--space-m);
  }

  .project-link {
    font-size: var(--step--1);
    color: var(--ink);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .project--featured {
      grid-template-columns: 1fr;
    }

    .project-compact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
