---
import BaseLayout from "../layouts/BaseLayout.astro";

// TODO(sathvik): bump this every time you actually update the page below.
const lastUpdated = "August 19, 2026";
---

<BaseLayout
  title="Now"
  description="What I'm building, reading, and learning at the moment."
>
  <article class="now">
    <h1>Now</h1>
    <p class="updated">Last updated {lastUpdated}.</p>

    <p class="explainer">
      This is a{" "}
      <a href="https://nownownow.com" rel="noopener noreferrer">
        /now page
      </a>
      , a small convention for saying what someone's actually focused on right
      now, instead of the frozen-in-time version of them you'd get from an
      "About" page. No feed, no history, just the current snapshot, replaced the
      next time it's true.
    </p>

    {/* TODO(sathvik): "Building" — one paragraph, what's on the workbench right now,
        and what part of it is actually hard.

        "Reading" — what's actually open on the nightstand or the tab bar, not the
        aspirational list.

        "Learning" — a skill or subject you're actively bad at and working on, the
        more specific the better. */}
  </article>
</BaseLayout>

<style>
  .now {
    max-width: var(--measure);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  h1 {
    font-size: var(--step-4);
  }

  .updated {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin-top: var(--space-xs);
  }

  .explainer {
    color: var(--muted);
    margin-top: var(--space-m);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  .section {
    margin-top: var(--space-l);
  }

  .section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }

  .section p {
    line-height: 1.7;
  }
</style>
