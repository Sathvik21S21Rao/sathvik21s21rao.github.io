---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../components/TagPill.astro';
import { site } from '../../config';

const allPosts = await getCollection('blog', (entry) =>
  import.meta.env.PROD ? !entry.data.draft : true
);

const counts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const max = Math.max(1, ...tags.map(([, n]) => n));
const min = Math.min(max, ...tags.map(([, n]) => n));

// Map frequency to a gentle range of the type scale.
const steps = ['--step--1', '--step-0', '--step-1', '--step-2'];
function sizeFor(count: number) {
  if (max === min) return steps[1];
  const ratio = (count - min) / (max - min);
  const idx = Math.min(steps.length - 1, Math.floor(ratio * steps.length));
  return steps[idx];
}
---

<BaseLayout title="Tags" description={`Everything written on ${site.name}, by tag.`}>
  <div class="tags-page">
    <div class="tags-page__mark" aria-hidden="true">{tags.length}</div>
    <div class="tags-page__main">
      <header class="tags-header">
        <h1>Tags</h1>
        <p><a href="/writing">All writing</a></p>
      </header>

      {tags.length === 0 ? (
        <p class="tags-empty">No tags yet.</p>
      ) : (
        <ul class="tag-index">
          {tags.map(([tag, count]) => (
            <li>
              <a
                class="tag-index__link"
                href={`/tags/${slugify(tag)}/`}
                style={`font-size: var(${sizeFor(count)})`}
              >
                {tag}
                <span class="tag-index__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    column-gap: var(--space-m);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .tags-page__mark {
    grid-column: 1;
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--muted);
    line-height: 1;
  }

  .tags-page__main {
    grid-column: 2;
    min-width: 0;
  }

  .tags-header {
    padding-bottom: var(--space-l);
  }

  .tags-header h1 {
    font-family: var(--font-display);
    font-size: var(--step-4);
  }

  .tags-header p {
    margin-top: var(--space-xs);
  }

  .tags-empty {
    color: var(--muted);
  }

  /* A composed index, not a cloud: alphabetical, run in columns like a
     book's back-matter index rather than a wrapped inline blob. */
  .tag-index {
    list-style: none;
    padding: 0;
    columns: 2;
    column-gap: var(--space-xl);
  }

  .tag-index li {
    break-inside: avoid;
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-xs);
  }

  .tag-index__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    font-family: var(--font-display);
    color: var(--ink);
    background-image: none;
  }

  .tag-index__link:hover,
  .tag-index__link:focus-visible {
    color: var(--accent-ink);
  }

  .tag-index__count {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .tags-page {
      grid-template-columns: 1fr;
      row-gap: var(--space-xs);
    }

    .tags-page__mark {
      grid-column: 1;
      font-size: var(--step-2);
    }

    .tags-page__main {
      grid-column: 1;
    }

    .tag-index {
      columns: 1;
    }
  }
</style>
