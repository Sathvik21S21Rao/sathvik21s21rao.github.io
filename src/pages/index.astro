---
import { site } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutIntro from "../components/AboutIntro.astro";
import OfficeScene from "../components/OfficeScene.astro";
import githubSvg from "@tabler/icons/outline/brand-github.svg?raw";
import mailSvg from "@tabler/icons/outline/mail.svg?raw";
import linkedinSvg from "@tabler/icons/outline/brand-linkedin.svg?raw";

const socialLabels: Record<string, string> = {
  github: "GitHub",
  email: "Email",
  linkedin: "LinkedIn",
  x: "X",
  bluesky: "Bluesky",
};

const icons: Record<string, string> = {
  github: githubSvg,
  email: mailSvg,
  linkedin: linkedinSvg,
};

const socials = Object.entries(site.socials).map(([key, value]) => ({
  key,
  icon: icons[key]?.replace("<svg", '<svg aria-hidden="true"'),
  label: socialLabels[key] ?? key,
  href: key === "email" ? `mailto:${value}` : value,
  display: key === "email" ? value : value.replace(/^https?:\/\/(www\.)?/, ""),
}));

// TODO(sathvik): fill in five: a food; a place; a tool or piece of software
// you'll defend in an argument; a genre, band, or specific album; something
// completely unrelated to computers.
const likes: string[] = [];
---

<BaseLayout title="About" description="A little about who's writing this.">
  <OfficeScene>
    <AboutIntro level="h1" />
  </OfficeScene>

  <div class="about-grid">
    <article class="about-content">
      {/* "How I got here" —
          TODO(sathvik): the honest, slightly winding version, not "I've always loved
          computers," but the actual turn or accident that got you paying attention.

          "What I'm chewing on" —
          TODO(sathvik): the current open question, obsession, or half-formed idea,
          something in progress, not resolved. This is the paragraph that changes most. */}

      {likes.length > 0 && (
        <section class="section">
          <h2>Things I like</h2>
          <ul class="likes">
            {likes.map((like) => (
              <li>{like}</li>
            ))}
          </ul>
        </section>
      )}

      <section class="section">
        <h2>Contact me</h2>
        <ul class="contact">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel={s.key === "email" ? undefined : "me noopener noreferrer"}
              >
                {s.icon && <span class="contact-icon" set:html={s.icon} />}
                {s.label} <span class="contact-value">{s.display}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .about-grid {
    padding-block: var(--space-l) 0;
  }

  .about-content {
    max-width: var(--measure);
    min-width: 0;
  }

  .section {
    margin-bottom: var(--space-xl);
  }

  /* Footer supplies its own top margin, so no trailing gap here */
  .section:last-child {
    margin-bottom: 0;
  }

  .section h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }

  .section p {
    line-height: 1.7;
  }

  .likes {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .likes li {
    padding-left: var(--space-m);
    position: relative;
  }

  .likes li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--accent-ink);
  }

  .contact {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .contact a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .contact-icon :global(svg) {
    width: 1.1em;
    height: 1.1em;
    display: inline-block;
    max-width: none;
    vertical-align: -0.2em;
    margin-right: 0.4em;
  }

  .contact-value {
    color: var(--muted);
  }

  .contact-value::before {
    content: " · ";
  }
</style>
