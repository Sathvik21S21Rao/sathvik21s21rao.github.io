---
import { site } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__name">{site.name}</a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* No full-width rule here on purpose - the baseline lives under the
       name only, sized to --rail, so it reads as a deliberate off-grid
       mark rather than the default hairline spanning the whole header. */
    padding-block-start: var(--space-xs);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    column-gap: var(--space-m);
    align-items: end;
    padding-block-end: var(--space-s);
  }

  .site-header__name {
    grid-column: 1;
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--ink);
    background-image: none;
    white-space: nowrap;
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--accent);
  }

  .site-header__nav {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-m);
    min-width: 0;
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__nav ul {
    display: flex;
    list-style: none;
    gap: var(--space-m);
    padding: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .site-header__nav ul::-webkit-scrollbar {
    display: none;
  }

  .site-header__nav a {
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
    background-size: 0% 1px;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--ink);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      grid-template-columns: 1fr;
      row-gap: var(--space-xs);
    }

    .site-header__name {
      grid-column: 1;
      border-bottom: none;
    }

    .site-header__nav {
      grid-column: 1;
      justify-content: space-between;
    }

    .site-header__nav ul {
      gap: var(--space-s);
    }
  }
</style>
