---
import { ClientRouter } from "astro:transitions";
import { site } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = site.description,
  ogType = "website",
} = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
---

<html lang="en">
  <head>
    <script is:inline>
      // ClientRouter's swapRootAttributes() replaces every attribute on
      // <html> with the incoming document's (which has none of these, since
      // this script only ever runs on a full load) - so data-theme has to be
      // reapplied after each swap, not just once here. astro:after-swap
      // fires once the new DOM is in but before paint, so the palette is
      // correct on the first frame with no flash; page-load fires later and
      // would show the wrong one for a beat. The listener lives on
      // `document`, which ClientRouter keeps across navigations, so
      // registering it once from a script that never re-runs is enough.
      const applyTheme = () => {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- opsz requested so the variable font actually varies with size instead of pinning to one optical cut -->
    <link
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>

    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
